# MedVox – Caddyfile-Vorlage. Wird von infra/tls/setup.sh nach
# ~/Library/Application Support/MedVox/caddy/Caddyfile gerendert.
#
# Eine Origin für alles (kein CORS):
#   https://<LAN-IP>/        → gebaute PWA aus app/dist
#   https://<LAN-IP>/api/... → FastAPI auf 127.0.0.1:8000
# Zertifikat: mkcert (eigene Praxis-CA), SANs medvox.local + LAN-IP.

{
	# Kein Let's Encrypt, keine Internetverbindung: Zertifikate kommen von mkcert.
	auto_https disable_redirects
	admin off
	# Laufzeitmeldungen gehen nach stderr und landen über launchd in
	# ~/Library/Logs/MedVox/caddy.log. Bewusst keine Zugriffslogs, und das
	# Fehlerlog (http.log.error, z. B. bei 502) ist ausgeschlossen, weil es
	# URI und Client-IP enthält – damit stehen weder Anfrage-URLs noch
	# Kurzcodes auf der Platte.
	log default {
		exclude http.log.error
	}
}

https://medvox.local:@@HTTPS_PORT@@, https://@@LAN_IP@@:@@HTTPS_PORT@@ {
	tls "@@CERT@@" "@@KEY@@"

	encode gzip

	# Backend (WP-2): FastAPI/uvicorn auf 127.0.0.1:8000
	handle /api/* {
		reverse_proxy @@API_UPSTREAM@@ {
			# Audio-Uploads: großzügige Zeitfenster, keine Pufferung
			transport http {
				read_timeout 120s
			}
		}
	}

	# PWA (WP-4): gebaute Dateien, SPA-Fallback auf index.html
	handle {
		root * "@@APP_DIST@@"
		try_files {path} /index.html
		file_server
	}

	header {
		# Keine Zwischenspeicherung von Transkripten durch Proxys/Browser
		Cache-Control "no-store"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

# Klartext-HTTP nur als Wegweiser auf HTTPS (kein Inhalt).
http://medvox.local, http://@@LAN_IP@@ {
	redir https://{host}:@@HTTPS_PORT@@{uri} permanent
}
